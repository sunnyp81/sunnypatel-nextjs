{
  "name": "sunnypatel-nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run test:tools && node scripts/normalize-content.mjs && node scripts/validate-blog-images.mjs && node scripts/build-light-image-manifest.mjs && next build",
    "test:tools": "node --test scripts/test-safe-public-fetch.mjs scripts/test-diagnostic-node-proxy.mjs && node scripts/test-tool-result-states.cjs",
    "start": "next start",
    "lint": "eslint",
    "normalize:content": "node scripts/normalize-content.mjs",
    "validate:content": "node scripts/normalize-content.mjs --check",
    "validate:blog-images": "node scripts/validate-blog-images.mjs",
    "cf:build": "opennextjs-cloudflare build && node scripts/cf-strip-og.mjs",
    "cf:preview": "npm run cf:build && opennextjs-cloudflare preview",
    "cf:deploy": "npm run cf:build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@keystatic/core": "^0.5.48",
    "@keystatic/next": "^5.0.4",
    "@markdoc/markdoc": "^0.5.4",
    "@opennextjs/cloudflare": "^1.20.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@tailwindcss/typography": "^0.5.19",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.34.2",
    "lucide-react": "^0.575.0",
    "motion": "^12.34.2",
    "next": "^16.3.8",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-icons": "^5.5.0",
    "resend": "^6.9.2",
    "tailwind-merge": "^3.5.0"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions"
  ],
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cheerio": "^1.2.0",
    "critters": "^0.0.23",
    "eslint": "^9",
    "eslint-config-next": "^16.3.8",
    "puppeteer": "^25.9.0",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4",
    "turndown": "^7.2.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "wrangler": "^4.142.0"
  }
}
